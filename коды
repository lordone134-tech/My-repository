-- 1. Вывести трек-номера для всей корреспонденции, отправленной в конвертах.
SELECT track_number FROM correspondence
WHERE code_types_cor IN (SELECT type_code FROM types_of_correspondence WHERE packaging = 'Конверт');

---- 2. Вывести виды корреспонденции, для которых средние значения длины, ширины и высоты являются пропорциональными.
-- 2. Вывести виды корреспонденции, для которых минимальные и максимальные значения длины, ширины и высоты являются пропорциональными.
SELECT *
FROM types_of_correspondence
WHERE (ABS(min_length * min_height - POWER(min_width,  2)) < 0.01
   AND ABS(max_length * max_height - POWER(max_width,  2)) < 0.01)   -- д/ш = ш/в
   OR (ABS(min_width  * min_height - POWER(min_length, 2)) < 0.01
   AND ABS(max_width  * max_height - POWER(max_length, 2)) < 0.01)   -- ш/д = д/в
   OR (ABS(min_length * min_width  - POWER(min_height, 2)) < 0.01
   AND ABS(max_length * max_width  - POWER(max_height, 2)) < 0.01);  -- д/в = в/ш

-- 3. Создать таблицу, содержащую данные 1 запроса с указанием веса, длины, ширины и высоты, а также всей информации о видах корреспонденции.
SELECT c.track_number, c.weight, c.length, c.width, c.height,
       t.type_code, t.type_name, t.packaging,
       t.min_weight, t.max_weight,
       t.min_length, t.min_width, t.min_height,
       t.max_length, t.max_width, t.max_height
INTO new_table
FROM correspondence c
JOIN types_of_correspondence t ON c.code_types_cor = t.type_code
WHERE t.packaging = 'Конверт';
