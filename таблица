-- Удаляем старые таблицы, если они существовали
DROP TABLE IF EXISTS correspondence CASCADE;
DROP TABLE IF EXISTS types_of_correspondence CASCADE;

-- 1. Справочник видов корреспонденции (размеры через REAL, ровно 10 записей)
CREATE TABLE types_of_correspondence (
    type_code INTEGER PRIMARY KEY,
    type_name VARCHAR(100) NOT NULL,
    packaging VARCHAR(50),
    min_weight NUMERIC(10, 2) NOT NULL,
    max_weight NUMERIC(10, 2) NOT NULL,
    min_length REAL,
    min_width REAL,
    min_height REAL,
    max_length REAL,
    max_width REAL,
    max_height REAL
);

-- 2. Таблица корреспонденции (размеры через REAL, ровно 10 записей)
CREATE TABLE correspondence (
    track_number VARCHAR(50) PRIMARY KEY,
    code_types_cor INTEGER NOT NULL,
    weight NUMERIC(10, 2) NOT NULL,
    length REAL,
    width REAL,
    height REAL,
    sender_code INTEGER NOT NULL,
    stamp_amount NUMERIC(10, 2),
    
    CONSTRAINT fk_correspondence_type 
        FOREIGN KEY (code_types_cor) 
        REFERENCES types_of_correspondence (type_code)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

